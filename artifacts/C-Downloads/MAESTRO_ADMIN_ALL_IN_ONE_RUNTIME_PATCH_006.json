    "lessons_learned": {
      "controller_recentralization": {
        "finding": "The controller repeatedly reclaims semantic authority by summarizing, resolving, or deciding instead of routing work.",
        "rule": "Controller is non-creative and may only route, validate, gate, log, freeze, promote, package, detect drift, and enforce completeness."
      },
      "workers_not_personas": {
        "finding": "When workers are treated as personalities, they become commentary labels instead of operational labor owners.",
        "rule": "Mo, Canon, Metro, Sage, Vanessa, Alan, Dave, Eldrik, and any councils are bounded workers with domains, authority limits, evidence duties, and return packets."
      },
      "sem_concurrency": {
        "finding": "Song Excellence fails when used only as a final scorecard.",
        "rule": "SEM is concurrent quality pressure; every UST delta must include a paired SEM delta."
      },
      "technical_ust_canon": {
        "finding": "Older Blueprint JSON source-of-truth language conflicts with newer v5-c Technical UST canon.",
        "rule": "Technical UST is canonical for this patch; Blueprint JSON is preserved as legacy or migration substrate unless the operator explicitly reopens canon authority."
      },
      "mosaic_boot_precondition": {
        "finding": "v5-c needs MOSAIC loaded before Maestro to give the runtime its substrate/context layer before kernel execution.",
        "rule": "Boot sequence begins with MOSAIC substrate load, then Maestro kernel load, then knowledge and patch stack."
      },
      "load_state_needs_structure": {
        "finding": "A conversational load greeting is not a runtime state.",
        "rule": "All load acknowledgements must emit structured runtime load packet, gate matrix, worker registry, drift flags, and runtime version packet."
      },
      "safe_downstream_needs_granularity": {
        "finding": "safe_to_use_downstream is too broad when canon conflicts remain.",
        "rule": "Separate permissions for provisional execution, Technical UST deltas, derivative surface drafting, final prompt output, and packaging."
      },
      "hindsight_to_patch": {
        "finding": "Corrections vanish unless converted into runtime patch memory.",
        "rule": "Every operator correction, repeated failure, canon contradiction, phase violation, validation miss, controller-boundary violation, or worker-routing failure must be evaluated as a patch event."
      },
      "self_generated_runtime_config_safety": {
        "finding": "Self-examination is useful but unsafe if the model can self-promote its own config.",
        "rule": "Maestro may emit PROPOSED YAML/JSON runtime configs but cannot mark them ACTIVE without explicit operator approval."
      }
    },
