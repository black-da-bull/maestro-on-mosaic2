        "requires": [
          "lyric_version_increment",
          "raw_diff",
          "reason",
          "syllable_check",
          "SEM_review"
        ]
      },
      "LOCKED": {
        "quoted_lyric_text": "immutable",
        "allowed_operations": [
          "metadata_annotation",
          "sfx_binding",
          "adlib_overlay",
          "non_lyric_section_header_adjustment"
        ],
        "forbidden_operations": [
          "quoted_line_rewrite",
          "paraphrase",
          "synonym_substitution",
          "line_reorder_without_LCR"
        ]
      },
      "LCR_required_for_downstream_lyric_change": {
