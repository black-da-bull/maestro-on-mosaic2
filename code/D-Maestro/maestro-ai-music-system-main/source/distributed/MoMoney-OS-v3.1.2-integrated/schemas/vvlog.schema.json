{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vvlog.json",
  "type": "object",
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "Macro",
              "Micro",
              "Tactical"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pass": {
            "type": "boolean"
          },
          "fixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "residual_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "phase",
          "checks",
          "pass",
          "timestamp"
        ]
      }
    },
    "sme_minutes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ejections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "phases"
  ]
}